{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_REMOTE_WS_URL": "ws://127.0.0.1:8787/ws/mobile",
        "EXPO_PUBLIC_REMOTE_API_URL": "http://127.0.0.1:8787"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_REMOTE_RELEASE": "1",
        "EXPO_PUBLIC_REMOTE_RELAY_HOST": "remote-terminal.example.invalid",
        "EXPO_PUBLIC_REMOTE_DEV_TOKEN": "replace-with-render-dev-token"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_REMOTE_RELEASE": "1",
        "EXPO_PUBLIC_REMOTE_RELAY_HOST": "remote-terminal.example.invalid",
        "EXPO_PUBLIC_REMOTE_DEV_TOKEN": "replace-with-render-dev-token"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {}
    }
  }
}
